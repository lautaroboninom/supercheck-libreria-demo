# Local development environment
# Copy this file as .env.local in your machine

VITE_DEMO_MODE=1
VITE_APP_NAME=SuperCheck Librería
VITE_COMPANY_LEGAL=SuperCheck Librería
VITE_SW=0

# Clave del lookup de codigos de barras (api/barcode-lookup.js). Va SIN prefijo
# VITE_ para que quede solo del lado servidor y no en el bundle del navegador,
# asi que en produccion se carga en Vercel > Settings > Environment Variables,
# no en este archivo.
#
# Es opcional: si falta, esa fuente se saltea (aparece como "not_configured" en
# el campo `sources` de la respuesta) y las otras cinco siguen funcionando.
#
# EAN-Search.org (paga) - https://www.ean-search.org/ean-database-api.html
EAN_SEARCH_API_TOKEN=
